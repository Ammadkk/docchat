# Copy to backend/.env and adjust. All settings are optional.
DOCCHAT_OLLAMA_HOST=http://localhost:11434
# Smaller machines: qwen2.5:3b or llama3.2:3b
DOCCHAT_LLM_MODEL=llama3.1:8b
DOCCHAT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# onnx (default, no PyTorch) or torch (needs: pip install sentence-transformers)
DOCCHAT_MODEL_BACKEND=onnx
# Cross-encoder reranking (downloads ~1 GB model on first use)
DOCCHAT_USE_RERANKER=false
DOCCHAT_CHUNK_TOKENS=500
DOCCHAT_CHUNK_OVERLAP_TOKENS=75
DOCCHAT_TOP_K=5
# Below this best vector similarity the app answers "not found" without calling the LLM
DOCCHAT_MIN_SIMILARITY=0.45
